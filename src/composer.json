{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "require": {
        "php": "^8.0.2",
        "fruitcake/laravel-cors": "^3.0",
        "guzzlehttp/guzzle": "^7.0.1",
        "laravel/framework": "^9.0",
        "laravel/sanctum": "^2.11",
        "laravel/socialite": "^5.2",
        "laravel/tinker": "^2.5"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "larastan/larastan": "^2.0",
        "laravel/pint": "^1.30",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.4.2",
        "nunomaduro/collision": "^6.1",
        "phpunit/phpunit": "^9.3.3",
        "spatie/laravel-ignition": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "composer:validate": "composer validate --strict",
        "composer:audit": "@php scripts/audit-guard.php",
        "composer:prod-check": "composer install --no-dev --prefer-dist --no-interaction --optimize-autoloader --dry-run",
        "format": "pint",
        "format:check": "pint --test",
        "analyse": "phpstan analyse --memory-limit=512M",
        "check": [
            "@composer:validate",
            "@composer:audit",
            "@composer:prod-check",
            "@format:check",
            "@analyse",
            "@php artisan test --log-junit result.xml"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "audit": {
            "abandoned": "report",
            "ignore": {
                "PKSA-3r5d-mb8f-1qw9": "laravel/frameworkのデフォルトemailバリデーションルールにおけるCRLFインジェクション(GHSA-5vg9-5847-vvmq)。Laravel 9.x系には修正版が存在しない(12.60.0/13.10.0以降でのみ修正)。本アプリケーションはメール送信機能を持たないため該当する攻撃経路は無いことを確認済み。Laravel 10以降への更新(Issue #236)まで許容する。",
                "PKSA-8qx3-n5y5-vvnd": "laravel/frameworkのファイルバリデーション不備(CVE-2025-27515)。Laravel 9.x系には修正版が存在しない(10.48.29/11.44.1/12.1.1以降でのみ修正)。本アプリケーションはファイルアップロード機能を持たないため該当する攻撃経路は無いことを確認済み。Laravel 10以降への更新(Issue #236)まで許容する。",
                "PKSA-m5cs-t1y6-qpcs": "laravel/frameworkの一時署名付きURLのパス混同(GHSA-crmm-hgp2-wgrp)。Laravel 9.x系には修正版が存在しない(12.61.1/13.12.0以降でのみ修正)。本アプリケーションは署名付きURLを使用していないため該当する攻撃経路は無いことを確認済み。Laravel 10以降への更新(Issue #236)まで許容する。",
                "PKSA-mdq4-51ck-6kdq": "laravel/frameworkのデフォルトemailバリデーションルールにおけるCRLFインジェクション(CVE-2026-48019、PKSA-3r5d-mb8f-1qw9と同一の脆弱性に対する別アドバイザリ)。Laravel 9.x系には修正版が存在しない。理由はPKSA-3r5d-mb8f-1qw9と同じ。Laravel 10以降への更新(Issue #236)まで許容する。"
            }
        }
    }
}
