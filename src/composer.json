{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.0.1",
        "laravel/framework": "^10.0",
        "laravel/socialite": "^5.2",
        "laravel/tinker": "^2.5"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "larastan/larastan": "^2.0",
        "laravel/pint": "^1.30",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.4.2",
        "nunomaduro/collision": "^7.0",
        "phpunit/phpunit": "^10.0",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "composer:validate": "composer validate --strict",
        "composer:audit": "@php scripts/audit-guard.php",
        "composer:prod-check": "composer install --no-dev --prefer-dist --no-interaction --optimize-autoloader --dry-run",
        "format": "pint",
        "format:check": "pint --test",
        "analyse": "phpstan analyse --memory-limit=512M",
        "check": [
            "@composer:validate",
            "@composer:audit",
            "@composer:prod-check",
            "@format:check",
            "@analyse",
            "@php artisan test --log-junit result.xml"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "audit": {
            "abandoned": "report",
            "ignore": {
                "PKSA-3r5d-mb8f-1qw9": "laravel/frameworkのデフォルトemailバリデーションルールにおけるCRLFインジェクション(GHSA-5vg9-5847-vvmq)。Laravel 10.x系には修正版が存在せず、Laravel 12.60.0以降で修正される。本アプリケーションはメール送信機能を持たないため該当する攻撃経路は無いことを確認済み。解消確認先: Issue #219（Laravel 12更新時）。baseline追跡: Issue #236。",
                "PKSA-m5cs-t1y6-qpcs": "laravel/frameworkの一時署名付きURLのパス混同(GHSA-crmm-hgp2-wgrp)。Laravel 10.x系には修正版が存在せず、Laravel 12.61.1以降で修正される。本アプリケーションは署名付きURLを使用していないため該当する攻撃経路は無いことを確認済み。解消確認先: Issue #219（Laravel 12更新時）。baseline追跡: Issue #236。",
                "PKSA-mdq4-51ck-6kdq": "laravel/frameworkのデフォルトemailバリデーションルールにおけるCRLFインジェクション(CVE-2026-48019、PKSA-3r5d-mb8f-1qw9と同一の脆弱性に対する別アドバイザリ)。Laravel 10.x系には修正版が存在せず、Laravel 12.60.0以降で修正される。理由はPKSA-3r5d-mb8f-1qw9と同じ。解消確認先: Issue #219（Laravel 12更新時）。baseline追跡: Issue #236。"
            }
        }
    }
}
